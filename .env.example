# === Variables de entorno para Red Escucha Psicológica ===
# Copiar a .env.local para desarrollo local, o configurar en Vercel > Settings > Environment Variables.

# === Base de datos (Neon Postgres) ===
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# === NextAuth ===
NEXTAUTH_SECRET="generar con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"  # en prod: https://www.redescuchapsicologica.com

# === Web Push Notifications (VAPID) ===
# Generar claves con: npx web-push generate-vapid-keys --json
# Estas claves SON OBLIGATORIAS para que las notificaciones push funcionen.
# La public key se comparte con el cliente (es pública por diseño).
# La private key NUNCA debe commitearse al repo.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:contacto@redescuchapsicologica.com"

# === Bot de WhatsApp (whatsapp-web.js en Render) ===
# Solo necesario si se reactiva el bot de WhatsApp.
WHATSAPP_API_SECRET="..."
GROQ_API_KEY="..."
